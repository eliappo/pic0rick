.program delayed_pulse
    pull block          ; delay - 3
    mov isr, osr
    pull block          ; width - 3
.wrap_target
    wait 1 irq 2        ; absolute IRQ 2, fired by burst_drive for all delayed-pulse SMs
    mov x, isr
delay_loop:
    jmp x-- delay_loop
    set pins, 1
    mov y, osr
width_loop:
    jmp y-- width_loop
    set pins, 0
.wrap

% c-sdk {

static inline void delayed_pulse_init(PIO pio, uint sm, uint offset,
                                              uint out_pin, float clkdiv) {
    pio_gpio_init(pio, out_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, out_pin, 1, true);

    pio_sm_config c = delayed_pulse_program_get_default_config(offset);
    sm_config_set_set_pins(&c, out_pin, 1);
    sm_config_set_clkdiv(&c, clkdiv);
    pio_sm_init(pio, sm, offset, &c);
}

// delay and width in ticks, both >= 3
static inline void delayed_pulse_load(PIO pio, uint sm, uint offset,
                                              uint32_t delay, uint32_t width) {
    pio_sm_set_enabled(pio, sm, false);
    pio_sm_clear_fifos(pio, sm);
    pio_sm_restart(pio, sm);
    pio_sm_exec(pio, sm, pio_encode_jmp(offset));
    pio_sm_put_blocking(pio, sm, delay - 3);
    pio_sm_put_blocking(pio, sm, width - 3);
}
%}
